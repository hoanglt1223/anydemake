# Writes a configured d3d11.dll with the tool, reads it back, then probes it.
file(REMOVE_RECURSE ${DIR})
file(MAKE_DIRECTORY ${DIR})
execute_process(COMMAND ${TOOL} --out ${DIR} ${TOOL_ARGS} RESULT_VARIABLE rc)
if(rc)
  message(FATAL_ERROR "anydemake --out failed: ${rc}")
endif()
execute_process(COMMAND ${TOOL} --read ${DIR} RESULT_VARIABLE rc OUTPUT_VARIABLE cfg)
if(rc)
  message(FATAL_ERROR "anydemake --read failed: ${rc}")
endif()
message(STATUS "${cfg}")
execute_process(COMMAND ${PROBE} ${DIR}/d3d11.dll ${PROBE_ARGS} RESULT_VARIABLE rc)
if(rc)
  message(FATAL_ERROR "probe failed: ${rc}")
endif()
execute_process(COMMAND ${TOOL} --remove ${DIR} RESULT_VARIABLE rc)
if(rc OR EXISTS ${DIR}/d3d11.dll)
  message(FATAL_ERROR "anydemake --remove failed")
endif()
