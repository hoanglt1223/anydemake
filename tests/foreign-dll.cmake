# A d3d11.dll from another mod is refused without --force, then backed up and restored.
file(REMOVE_RECURSE ${DIR})
file(WRITE ${DIR}/d3d11.dll "another mod")
execute_process(COMMAND ${TOOL} --out ${DIR} --preset ps1 RESULT_VARIABLE rc)
file(READ ${DIR}/d3d11.dll content)
if(NOT rc OR NOT content STREQUAL "another mod")
  message(FATAL_ERROR "foreign d3d11.dll was not protected")
endif()
execute_process(COMMAND ${TOOL} --out ${DIR} --preset ps1 --force RESULT_VARIABLE rc)
if(rc OR NOT EXISTS ${DIR}/d3d11.dll.potatomode-backup)
  message(FATAL_ERROR "--force did not back up")
endif()
execute_process(COMMAND ${TOOL} --remove ${DIR} RESULT_VARIABLE rc)
file(READ ${DIR}/d3d11.dll content)
if(rc OR NOT content STREQUAL "another mod")
  message(FATAL_ERROR "backup not restored")
endif()
