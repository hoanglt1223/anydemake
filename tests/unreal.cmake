# A fake packaged Unreal game: DLLs go next to the real exe, Engine.ini gets
# one Potatify block that is replaced on reinstall and removed cleanly.
file(REMOVE_RECURSE ${DIR})
set(bin ${DIR}/game/MyGame/Binaries/Win64)
file(MAKE_DIRECTORY ${DIR}/game/Engine ${bin})
file(WRITE ${bin}/MyGame-Win64-Shipping.exe "")
set(ENV{LOCALAPPDATA} ${DIR}/appdata)
set(ini ${DIR}/appdata/MyGame/Saved/Config/Windows/Engine.ini)
file(WRITE ${ini} "[/Script/Engine.RendererSettings]\nr.Foo=1\n")
# Read back: file(WRITE) may translate line endings.
file(READ ${ini} original)

function(run)
  execute_process(COMMAND ${TOOL} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(rc)
    message(FATAL_ERROR "potatify ${ARGN} failed: ${out}${err}")
  endif()
endfunction()

function(count_blocks want)
  file(READ ${ini} text)
  string(REGEX MATCHALL "potatify begin" blocks "${text}")
  list(LENGTH blocks n)
  if(NOT n EQUAL want)
    message(FATAL_ERROR "Engine.ini has ${n} Potatify blocks, want ${want}:\n${text}")
  endif()
endfunction()

run(--out ${DIR}/game --preset ps1)
foreach(dll d3d11.dll d3d12.dll)
  if(NOT EXISTS ${bin}/${dll})
    message(FATAL_ERROR "${dll} not installed next to the shipping exe")
  endif()
endforeach()
file(READ ${ini} text)
if(NOT text MATCHES "r\\.ScreenPercentage=50" OR NOT text MATCHES "r\\.MipMapLODBias=3" OR NOT text MATCHES "r\\.Foo=1")
  message(FATAL_ERROR "Engine.ini settings missing:\n${text}")
endif()
count_blocks(1)

# Reinstall from the Binaries folder with other settings: still one block.
run(--out ${bin} --preset light)
count_blocks(1)
file(READ ${ini} text)
if(text MATCHES "ScreenPercentage")
  message(FATAL_ERROR "old block not replaced:\n${text}")
endif()

run(--remove ${DIR}/game)
file(READ ${ini} text)
if(NOT text STREQUAL original)
  message(FATAL_ERROR "Engine.ini not restored:\n${text}")
endif()
if(EXISTS ${bin}/d3d11.dll OR EXISTS ${bin}/d3d12.dll)
  message(FATAL_ERROR "DLLs not removed")
endif()

run(--out ${DIR}/game --preset ps1 --unreal off)
count_blocks(0)

# The game rewrote Engine.ini and dropped our marker comments: Remove restores the first original.
run(--remove ${DIR}/game)
run(--out ${DIR}/game --preset ps1)
file(WRITE ${ini} "[SystemSettings]\nr.ScreenPercentage=50\n")
run(--remove ${DIR}/game)
file(READ ${ini} text)
if(NOT text STREQUAL original)
  message(FATAL_ERROR "Engine.ini not restored from the backup:\n${text}")
endif()
