# With logging on, the proxy writes fps, frame time and VRAM lines every 5 s.
file(REMOVE_RECURSE ${DIR})
file(MAKE_DIRECTORY ${DIR})
execute_process(COMMAND ${TOOL} --out ${DIR} --preset off --log RESULT_VARIABLE rc)
if(rc)
  message(FATAL_ERROR "anydemake --out failed")
endif()
execute_process(COMMAND ${PROBE} ${DIR}/d3d11.dll present-for 6 RESULT_VARIABLE rc)
if(rc)
  message(FATAL_ERROR "probe failed")
endif()
file(READ ${DIR}/anydemake-d3d11.log text)
message(STATUS "${text}")
if(NOT text MATCHES "fps [0-9.]+, frame [0-9.]+ ms average, [0-9.]+ ms worst, VRAM [0-9]+ MB")
  message(FATAL_ERROR "no fps line in the log")
endif()
